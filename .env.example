# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# ── Database (Phase 1) ───────────────────────────────────────────────────
# Supabase Postgres connection string. In Supabase: Project Settings →
# Database → Connection string → "URI" (use the pooled "Transaction" mode
# connection string for serverless/Vercel deployments).
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ── NextAuth (Phase 1) ───────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Local dev default. Set to your real production URL when deployed
# (e.g. https://bilalpaintinguk.co.uk) via your hosting provider's env vars.
NEXTAUTH_URL="http://localhost:3000"

# ── Initial admin account (Phase 1 — used only by prisma/seed.js) ───────
# After the first successful seed + login, you can change the password
# from inside the dashboard (Phase 2) or by re-running the seed with new
# values — it's safe to re-run.
ADMIN_EMAIL="admin@bilalpaintinguk.co.uk"
ADMIN_PASSWORD="replace-with-a-strong-password"

# ── Cloudinary (Phase 2 — required for the Media Library) ───────────────
# Find these in your Cloudinary dashboard under "API Keys".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
