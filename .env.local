DATABASE_URL="postgresql://postgres.svajaiolfsfjhhrkebsn:Khawaja%40Anees143@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.svajaiolfsfjhhrkebsn:Khawaja%40Anees143@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ── NextAuth (Phase 1) ───────────────────────────────────────────────────
